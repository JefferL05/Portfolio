---
import { getGitHubUser } from '../lib/github';
const user = await getGitHubUser();
---

<section class="relative py-20 md:py-32 overflow-hidden">
  <!-- Grid de fundo -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b20_1px,transparent_1px),linear-gradient(to_bottom,#1e293b20_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_60%_at_50%_0%,black,transparent)]"></div>

  <div class="relative max-w-6xl mx-auto px-6">
    <div class="flex flex-col md:flex-row items-start md:items-center gap-8 md:gap-12">
      <!-- Avatar -->
      <div class="shrink-0">
        <img
          src={user.avatar_url}
          alt={`Foto de ${user.name}`}
          class="w-28 h-28 md:w-36 md:h-36 rounded-full border-2 border-accent/30 shadow-lg shadow-accent/10"
          loading="eager"
        />
      </div>

      <!-- Info -->
      <div class="flex-1">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2.5 h-2.5 rounded-full bg-terminal-green animate-pulse"></span>
          <span class="text-terminal-green text-sm font-mono">disponÃ­vel para projetos</span>
        </div>

        <h1 class="text-4xl md:text-5xl font-bold text-white mb-3">
          {user.name}
        </h1>

        <p class="text-slate-400 text-lg mb-4 max-w-xl">
          {user.bio}
        </p>

        <div class="flex flex-wrap items-center gap-4 text-sm text-slate-500">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            {user.location}
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            {user.public_repos} repositÃ³rios
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/></svg>
            {user.followers} seguidores
          </span>
        </div>

        <!-- Terminal decorativo -->
        <div class="mt-8 terminal-window max-w-lg">
          <div class="terminal-header">
            <span class="terminal-dot bg-terminal-red/80"></span>
            <span class="terminal-dot bg-terminal-yellow/80"></span>
            <span class="terminal-dot bg-terminal-green/80"></span>
            <span class="ml-2 text-xs text-slate-500">jeff@dev ~</span>
          </div>
          <div class="terminal-body">
            <p><span class="text-terminal-green">â</span> <span class="text-terminal-cyan">~/portfolio</span> cat skills.txt</p>
            <p class="text-slate-300 mt-1">JavaScript â¢ TypeScript â¢ React â¢ Next.js â¢ Node.js</p>
            <p class="text-slate-300">Java â¢ Android â¢ Unity â¢ C# â¢ Astro â¢ PWA</p>
            <p class="mt-2"><span class="text-terminal-green">â</span> <span class="text-terminal-cyan">~/portfolio</span> <span class="animate-blink text-white">â</span></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
